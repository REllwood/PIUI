{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piui.local/schema/envelope.schema.json",
  "title": "PIUI private protocol envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "id", "sequence", "payload"],
  "properties": {
    "version": { "const": 1 },
    "kind": {
      "enum": ["handshake", "request", "response", "event", "host-request", "host-response", "cancel", "ack"]
    },
    "id": { "$ref": "#/$defs/id" },
    "correlationId": { "$ref": "#/$defs/id" },
    "decisionId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "payload": { "type": "object", "maxProperties": 128 },
    "error": { "$ref": "#/$defs/error" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {
          "enum": ["invalid-request", "unsupported-version", "unavailable", "cancelled", "timeout", "permission-denied", "conflict", "internal"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "diagnosticId": { "$ref": "#/$defs/id" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["response", "host-response", "ack"] } } },
      "then": { "required": ["correlationId"], "properties": { "correlationId": { "$ref": "#/$defs/id" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "cancel" } } },
      "then": { "required": ["correlationId"], "properties": { "correlationId": { "$ref": "#/$defs/id" }, "payload": { "type": "object", "maxProperties": 1 } } }
    }
  ]
}
