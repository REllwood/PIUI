{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIUI",
  "version": "0.1.0",
  "identifier": "au.com.piui.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/tauri-build-hook.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' piui-raster:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; media-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "PIUI",
        "width": 1280,
        "height": 800,
        "minWidth": 680,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 18 }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/piui-node"],
    "resources": [
      "resources/sidecar",
      "resources/THIRD-PARTY-NOTICES.txt",
      "resources/piui.cdx.json"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
