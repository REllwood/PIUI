{
  "name": "piui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "provision:architecture-toolchain": "node scripts/provision-architecture-toolchain.mjs",
    "dev": "vite",
    "build": "node scripts/run-suite.mjs web-build",
    "format:check": "node scripts/run-suite.mjs format",
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "node scripts/run-suite.mjs types",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "fixture:smoke": "node scripts/run-fixture-app.mjs",
    "test:e2e": "node scripts/run-suite.mjs e2e",
    "test:workbench": "playwright test --config playwright.workbench.config.ts",
    "test:a11y": "playwright test --config playwright.accessibility.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:simple-workspace": "node scripts/run-suite.mjs simple-workspace",
    "test:advanced": "node scripts/run-suite.mjs advanced",
    "test:onboarding": "node scripts/run-suite.mjs onboarding",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "performance:report": "node scripts/performance-report.mjs",
    "tauri": "node scripts/tauri-development.mjs",
    "test:protocol": "pnpm --filter @piui/protocol test",
    "test:protocol:all": "node scripts/run-suite.mjs protocol-all",
    "test:unit": "vitest run src/domain src/bridge src/app/commands.test.ts src/features/appearance/appearance.test.ts src/styles/tokens.test.ts",
    "test:components": "vitest run src/features/component-state.test.tsx src/components/primitives/primitives.test.tsx src/components/work-trace/work-trace.test.tsx src/features/appearance/AppearanceProvider.test.tsx src/features/composer/ModelPicker.test.tsx src/components/transcript/transcript.test.tsx",
    "test:contract": "pnpm --filter @piui/sidecar build && vitest run tests/contract",
    "test:security": "node scripts/run-security-tests.mjs",
    "test:streaming": "node scripts/run-suite.mjs streaming",
    "test:updates": "node scripts/run-suite.mjs updates",
    "test:lifecycle": "node scripts/run-suite.mjs lifecycle",
    "stage:sidecar": "node scripts/run-suite.mjs stage-sidecar",
    "test:packaged:inspection": "node scripts/provision-node-runtime.mjs && node --test tests/packaged/*.test.mjs",
    "test:packaged:credential-groundwork": "node --test tests/packaged/secret-canary-scanner.test.mjs && vitest run tests/packaged/credential-lifecycle.spec.ts",
    "test:packaged:approval-groundwork": "vitest run tests/packaged/approval-matrix.spec.ts",
    "test:packaged": "node scripts/run-suite.mjs packaged",
    "spike:package:inspect": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package",
    "spike:packaged:sdk": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a22",
    "spike:packaged:credentials": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a23",
    "spike:packaged:trust": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a24",
    "spike:packaged:approvals": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a25",
    "spike:packaged:markdown": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a26",
    "spike:packaged:lifecycle": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a27",
    "spike:packaged:accessibility": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb package --authoritative-a28",
    "gate:architecture": "node scripts/check-architecture-gate.mjs",
    "gate:architecture:record": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb record",
    "audit:dependencies": "node --test tests/packaged/dependency-security.test.mjs && node scripts/check-dependency-audit.mjs",
    "tauri:build:production": "/usr/bin/env -i PATH=/usr/bin:/bin LANG=en_AU.UTF-8 LC_ALL=en_AU.UTF-8 /usr/bin/ruby --disable-gems scripts/architecture-bootstrap.rb build",
    "test:sidecar-closure": "node scripts/test-sidecar-closure.mjs",
    "test:sidecar-closure-policy": "node scripts/test-sidecar-closure-policy.mjs",
    "test:sidecar-routing": "node scripts/test-sidecar-routing.mjs",
    "test:sidecar-auth-routing": "node scripts/test-sidecar-auth-routing.mjs",
    "test:sidecar-repeat": "node scripts/test-sidecar-repeat.mjs",
    "release:metadata": "node scripts/run-suite.mjs release-metadata",
    "security:threat-model": "node scripts/check-security-record.mjs",
    "security:supply-chain": "node scripts/run-suite.mjs supply-chain",
    "security:full": "node scripts/run-suite.mjs security-full",
    "review:correctness": "node scripts/run-suite.mjs review-correctness",
    "review:ui": "node scripts/run-suite.mjs review-ui",
    "docs:check": "node scripts/check-docs.mjs",
    "release:local": "node scripts/build-local-release.mjs",
    "release:verify": "node scripts/run-suite.mjs release-verify",
    "forge:close": "node scripts/check-forge-close.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@piui/protocol": "workspace:*",
    "@tanstack/react-virtual": "3.14.8",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@axe-core/playwright": "4.12.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/tauri-service": "1.2.0",
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <6.0.0": "5.0.9",
      "serialize-javascript": "7.0.5",
      "undici@8": "8.10.2",
      "fast-uri@3": "3.1.8",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.19",
      "deepmerge-ts@7": "8.0.2",
      "@puppeteer/browsers@2": "3.2.2"
    }
  }
}
